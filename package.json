{
  "name": "clean-clock",
  "author": "MakeAwesomeHappen",
  "version": "1.0.0",
  "keywords": [
    "pebble-app"
  ],
  "private": true,
  "scripts": {
    "gen-fonts": "python3 scripts/ttf_to_svg_font.py"
  },
  "dependencies": {
    "pebble-fctx": "^1.6.5",
    "pebble-utf8": "^1.0.4"
  },
  "pebble": {
    "displayName": "clean-clock",
    "uuid": "9d6451e5-8e00-4bf5-b8a1-5e223f6c610b",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": [
      "aplite",
      "basalt",
      "diorite",
      "emery",
      "flint"
    ],
    "watchapp": {
      "watchface": true
    },
    "capabilities": [
      "configurable",
      "health",
      "location"
    ],
    "messageKeys": [
      "TIME_FORMAT",
      "TEMP_UNIT",
      "LANGUAGE",
      "TIME_FONT",
      "WEATHER_INTERVAL",
      "WEATHER_LOCATION",
      "TOP_PRIMARY_COLOR",
      "TOP_SECONDARY_COLOR",
      "TOP_LEFT_ELEMENT",
      "TOP_CENTER_ELEMENT",
      "TOP_RIGHT_ELEMENT",
      "BOTTOM_PRIMARY_COLOR",
      "BOTTOM_SECONDARY_COLOR",
      "BOTTOM_LEFT_ELEMENT",
      "BOTTOM_CENTER_ELEMENT",
      "BOTTOM_RIGHT_ELEMENT",
      "WEATHER_TEMP",
      "WEATHER_ICON",
      "WEATHER_TODAY_MIN",
      "WEATHER_TODAY_MAX",
      "WEATHER_TOMORROW_TEMP",
      "WEATHER_TOMORROW_ICON",
      "WEATHER_TOMORROW_MIN",
      "WEATHER_TOMORROW_MAX",
      "READY"
    ],
    "resources": {
      "media": [
        {
          "file": "EBGaramond.ffont",
          "name": "EB_GARAMOND",
          "type": "raw"
        },
        {
          "file": "LECO1976.ffont",
          "name": "LECO_1976",
          "type": "raw"
        }
      ]
    }
  },
  "devDependencies": {
    "pebble-fctx-compiler": "^1.2.2"
  }
}
